# ── MADDA ERP environment ─────────────────────────────────────────────
# Copy to .env at the repo root and adjust.

# Database (PostgreSQL). Create the DB first (see README).
DATABASE_URL="postgresql://madda:madda@localhost:5432/madda?schema=public"

# API
API_PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
CORS_ORIGIN="http://localhost:5173"

# Seed admin (created on first seed)
SEED_ADMIN_EMAIL="admin@madda.local"
SEED_ADMIN_PASSWORD="Admin@12345"

# Currency defaults
DEFAULT_CURRENCY="ETB"
USD_TO_ETB="125"

# Email
# MAIL_PROVIDER is mailtrap | gmail | none.
#
# Mailtrap transactional sending. SMTP_PASS is the API token for the sending
# domain, and each domain has its own token, so MAIL_FROM must be an address on
# the verified domain or Mailtrap rejects the message.
MAIL_PROVIDER="mailtrap"
SMTP_HOST="live.smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER="api"
SMTP_PASS=""
MAIL_FROM="Ancient Halo Coffee <no-reply@ancienthalo.coffee>"
MAIL_REPLY_TO=""

# Gmail SMTP fallback (used when MAIL_PROVIDER=gmail)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Web
VITE_API_URL="http://localhost:4000/api"
