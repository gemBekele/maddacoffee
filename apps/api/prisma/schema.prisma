// MADDA ERP — Prisma schema (Phase 1 core + sales scaffold)
// Status/process/grade/etc. are Strings backed by the Lookup table so they stay configurable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity / system ─────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  language     String    @default("en")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles      UserRole[]
  stations   UserStation[]
  auditLogs  AuditLog[]

  @@map("users")
}

model Role {
  id    String @id @default(cuid())
  key   String @unique
  label String

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserStation {
  userId    String
  stationId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([userId, stationId])
  @@map("user_stations")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Lookup {
  id       String  @id @default(cuid())
  type     String // process | grade | expense_category | payment_method | supplier_type | station_status | ...
  code     String
  nameEn   String
  nameOm   String?
  sort     Int     @default(0)
  isActive Boolean @default(true)

  @@unique([type, code])
  @@map("lookups")
}

model Currency {
  code    String  @id
  symbol  String
  labelEn String
  labelOm String?
  isBase  Boolean @default(false)

  @@map("currencies")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  fromCode  String
  toCode    String
  rate      Decimal  @db.Decimal(18, 8)
  effective DateTime @default(now())

  @@index([fromCode, toCode, effective])
  @@map("exchange_rates")
}

model NumberSequence {
  id        String   @id @default(cuid())
  key       String @unique // purchase | proforma | commercial | ...
  prefix    String
  includeYear Boolean @default(true)
  padding   Int      @default(4)
  reset     String   @default("yearly") // never | yearly | monthly
  current   Int      @default(0)
  periodTag String   @default("")
  updatedAt DateTime @updatedAt

  @@map("number_sequences")
}

model Attachment {
  id         String   @id @default(cuid())
  entity     String
  entityId   String
  fileName   String
  mimeType   String?
  size       Int?
  storageKey String
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@map("attachments")
}

// ───────────────────────────── Master data ─────────────────────────────

model Station {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  region       String?
  zone         String?
  location     String?
  manager      String?
  capacityTons Decimal?  @db.Decimal(12, 2)
  startDate    DateTime?
  status       String    @default("Active")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users       UserStation[]
  employees   Employee[]
  purchases   CherryPurchase[]
  batches     ProcessingBatch[]
  lots        Lot[]
  expenses    Expense[]
  payments    Payment[]

  @@map("stations")
}

model Supplier {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String   @default("Farmer")
  // Optional link to the traceability registry. A supplier may be a loose
  // market trader with no farm plots behind it, so this is deliberately nullable.
  producerId  String?
  phone       String?
  location    String?
  bankInfo    String?
  status      String   @default("Active")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  producer  Producer?       @relation(fields: [producerId], references: [id])
  purchases CherryPurchase[]

  @@index([producerId])
  @@map("suppliers")
}

model Buyer {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  country     String?
  contactName String?
  email       String?
  phone       String?
  incoterm    String   @default("FOB")
  currency    String   @default("USD")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotations         Quotation[]
  proformas          ProformaInvoice[]
  contracts          SalesContract[]
  commercialInvoices CommercialInvoice[]

  @@map("buyers")
}

// ───────────────────────────── Supply side ─────────────────────────────

model CherryPurchase {
  id            String   @id @default(cuid())
  code          String   @unique
  date          DateTime
  stationId     String
  supplierId    String
  receiptNo     String?
  cherryKg      Decimal  @db.Decimal(14, 3)
  pricePerKg    Decimal  @db.Decimal(14, 2)
  totalAmount   Decimal  @db.Decimal(18, 2)
  currency      String   @default("ETB")
  paymentStatus String   @default("Pending")
  paymentId     String?
  harvestYear   String?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  station  Station  @relation(fields: [stationId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([stationId, date])
  @@map("cherry_purchases")
}

model ProcessingBatch {
  id                String   @id @default(cuid())
  code              String   @unique
  date              DateTime
  stationId         String
  lotId             String?
  process           String
  cherryInputKg     Decimal  @db.Decimal(14, 3)
  parchmentOutputKg Decimal? @db.Decimal(14, 3)
  dryParchmentKg    Decimal? @db.Decimal(14, 3)
  greenOutputKg     Decimal? @db.Decimal(14, 3)
  moisturePct       Decimal? @db.Decimal(5, 2)
  grade             String?
  screenSize        String?
  cuppingScore      Decimal? @db.Decimal(5, 2)
  status            String   @default("Planned")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  station Station @relation(fields: [stationId], references: [id])
  lot     Lot?    @relation(fields: [lotId], references: [lotId])

  @@index([stationId, date])
  @@map("processing_batches")
}

model Lot {
  lotId        String   @id // human-readable e.g. LOT-ST001-NAT-001
  stationId    String
  origin       String?
  region       String? // Yirgacheffe / Sidama / Guji / Harrar ...
  zone         String?
  woreda       String?
  kebele       String?
  coffeeType   String   @default("Arabica") // Arabica | Robusta | Blend
  form         String   @default("Green") // Green | Roasted | Soluble | Liquid
  harvestYear  String?
  harvestPeriod String? // e.g. 2025/26 main crop
  process      String
  grade        String?
  screenSize   String?
  moisturePct  Decimal? @db.Decimal(5, 2)
  defectCount  Int?
  defectPct    Decimal? @db.Decimal(5, 2)
  cuppingScore Decimal? @db.Decimal(5, 2)
  organic      Boolean  @default(false)
  bagCount     Int?
  bagNumbers   String? // comma-separated; ICO UCR / ICO identification marks
  netWeightKg  Decimal? @db.Decimal(14, 3)
  grossWeightKg Decimal? @db.Decimal(14, 3)
  warehouse    String?
  ecxWarehouseReceipt String?
  ecxGrade     String?
  ecxCertDate  DateTime?
  qualityCertRef String? // CLU quality certificate reference
  status       String   @default("Active") // Active | Exported | Closed
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  station  Station           @relation(fields: [stationId], references: [id])
  batches  ProcessingBatch[]
  inventory InventoryItem[]
  traces    LotTrace[]
  documents LotDocument[]

  @@map("lots")
}

// ───────────────────────────── Traceability (EUDR) ─────────────────────────────
// Producer is deliberately either a FARMER or a WASHING_STATION/COOPERATIVE.
// `kind` decides whether Plot polygons attach per-farm or per-station, which is
// the single biggest driver of field-data collection effort.

model Producer {
  id       String   @id @default(cuid())
  code     String   @unique
  name     String
  kind     String   @default("FARMER") // FARMER | WASHING_STATION | COOPERATIVE
  phone    String?
  region   String?
  zone     String?
  woreda   String?
  kebele   String?
  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  notes    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plots      Plot[]
  suppliers  Supplier[]

  @@map("producers")
}

model Plot {
  id             String   @id @default(cuid())
  producerId     String
  name           String?
  region         String?
  zone           String?
  woreda         String?
  kebele         String?
  // GeoJSON Polygon per EUDR Reg. 2023/1115 Art. 9(1)(d). Polygons required for
  // plots > 4 ha; a single 6-decimal point is acceptable below that threshold.
  polygon        Json?
  geolocationMethod String? // GPS | GIS | MAPPED
  areaHa         Decimal? @db.Decimal(10, 4)
  landTenure     String? // FREEHOLD | LEASE | HGU | COOPERATIVE | OTHER
  legalityDocRef String?
  harvestedFrom  DateTime? // production date/time range (EUDR Art. 9(1)(e))
  harvestedTo    DateTime?
  registeredAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt

  producer Producer   @relation(fields: [producerId], references: [id], onDelete: Cascade)
  traces   LotTrace[]
  eudrLinks EudrPlotLink[]

  @@index([producerId])
  @@map("plots")
}

// The single join that answers all three traceability questions:
//   which plots contributed to this lot  -> by lotId
//   which shipments contain this lot     -> lotId <- CommercialInvoiceLine
//   which plots reach this shipment      -> lotId -> shipment -> eudrLinks
model LotTrace {
  lotId           String
  plotId          String
  cherryPurchaseId String?
  contributedKg   Decimal @db.Decimal(14, 3)
  recordedAt      DateTime @default(now())

  lot  Lot   @relation(fields: [lotId], references: [lotId], onDelete: Cascade)
  plot Plot   @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@id([lotId, plotId])
  @@index([plotId])
  @@map("lot_traces")
}

// Certificates and quality results that belong to a specific lot.
model LotDocument {
  id         String   @id @default(cuid())
  lotId      String
  docType    String // CLU Quality Certificate | Organic Certificate | Cupping Report | ECX Cert
  reference  String?
  issuedBy   String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  attachmentId String?
  notes      String?
  createdAt  DateTime @default(now())

  lot Lot @relation(fields: [lotId], references: [lotId], onDelete: Cascade)

  @@index([lotId])
  @@map("lot_documents")
}

model InventoryItem {
  id          String   @id @default(cuid())
  lotId       String
  stationId   String
  coffeeType  String?
  process     String?
  grade       String?
  screenSize  String?
  quantityKg  Decimal  @db.Decimal(14, 3) @default(0)
  warehouse   String?
  unitCost    Decimal  @db.Decimal(14, 2) @default(0)
  currency    String   @default("ETB")
  status      String   @default("Available")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  lot       Lot                 @relation(fields: [lotId], references: [lotId])
  movements InventoryMovement[]

  @@unique([lotId, warehouse])
  @@map("inventory_items")
}

model InventoryMovement {
  id         String   @id @default(cuid())
  itemId     String
  direction  String // IN | OUT | ADJUST
  quantityKg Decimal  @db.Decimal(14, 3)
  unitCost   Decimal  @db.Decimal(14, 2) @default(0)
  reference  String?
  notes      String?
  createdById String?
  createdAt  DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("inventory_movements")
}

// ───────────────────────────── Money ─────────────────────────────

model Expense {
  id            String   @id @default(cuid())
  code          String   @unique
  date          DateTime
  stationId     String
  category      String
  description   String
  amount        Decimal  @db.Decimal(18, 2)
  currency      String   @default("ETB")
  paymentStatus String   @default("Pending")
  paymentId     String?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  station Station @relation(fields: [stationId], references: [id])

  @@index([stationId, date])
  @@map("expenses")
}

// Retired: the Payments page was removed in favour of Expenses. The model and
// its table are kept so historical records survive; nothing writes to it.
model Payment {
  id          String   @id @default(cuid())
  code        String   @unique
  date        DateTime
  stationId   String?
  payee       String
  type        String
  referenceId String?
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("ETB")
  method      String   @default("Cash")
  status      String   @default("Pending")
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station Station? @relation(fields: [stationId], references: [id])

  @@index([stationId, date])
  @@map("payments")
}

// ───────────────────────────── Sales / export scaffold ─────────────────────────────

model Quotation {
  id        String   @id @default(cuid())
  code      String   @unique
  date      DateTime
  buyerId   String
  currency  String   @default("USD")
  incoterm  String   @default("FOB")
  validUntil DateTime?
  status    String   @default("Draft") // Draft | Sent | Accepted | Expired | Cancelled
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer Buyer             @relation(fields: [buyerId], references: [id])
  lines QuotationLine[]

  @@map("quotations")
}

model QuotationLine {
  id            String  @id @default(cuid())
  quotationId   String
  lotId         String?
  description   String
  quantityKg    Decimal @db.Decimal(14, 3)
  pricePerKg    Decimal @db.Decimal(14, 4)
  amount        Decimal @db.Decimal(18, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_lines")
}

model ProformaInvoice {
  id         String   @id @default(cuid())
  code       String   @unique // PRO-YYYY-####
  date       DateTime
  buyerId    String
  quotationId String?
  currency   String   @default("USD")
  incoterm   String   @default("FOB")
  portLoading String?
  portDischarge String?
  validity   DateTime?
  paymentTerms String?
  status     String   @default("Draft") // Draft | Issued | Sent | Accepted | Converted | Cancelled
  referenceProformaId String? // when converted
  notes      String?
  createdById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  buyer     Buyer              @relation(fields: [buyerId], references: [id])
  lines     ProformaInvoiceLine[]
  contract  SalesContract?
  commercial CommercialInvoice?

  @@map("proforma_invoices")
}

model ProformaInvoiceLine {
  id           String  @id @default(cuid())
  proformaId   String
  lotId        String?
  description  String
  quantityKg   Decimal @db.Decimal(14, 3)
  pricePerKg   Decimal @db.Decimal(14, 4)
  amount       Decimal @db.Decimal(18, 2)

  proforma ProformaInvoice @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@map("proforma_invoice_lines")
}

model SalesContract {
  id           String   @id @default(cuid())
  code         String   @unique
  date         DateTime
  buyerId      String
  proformaId   String?  @unique
  currency     String   @default("USD")
  incoterm     String   @default("FOB")
  amount       Decimal  @db.Decimal(18, 2)
  eptaRef      String? // ECTA registration reference
  signedAt     DateTime?
  status       String   @default("Draft") // Draft | Signed | Registered | Completed | Cancelled
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  buyer    Buyer            @relation(fields: [buyerId], references: [id])
  proforma ProformaInvoice? @relation(fields: [proformaId], references: [id])
  shipment Shipment?
  commercial CommercialInvoice?

  @@map("sales_contracts")
}

model CommercialInvoice {
  id            String   @id @default(cuid())
  code          String   @unique // keeps proforma reference
  date          DateTime
  buyerId       String
  proformaId    String?  @unique
  contractId    String?  @unique
  currency      String   @default("USD")
  fobPricePerKg Decimal? @db.Decimal(14, 4)
  incoterm      String   @default("FOB")
  hsCode        String?  @default("0901.11")
  // Commercial terms carry the destination. The export document pack is
  // assembled against the invoice, not the shipment: the invoice is what the
  // bank, customs, and the buyer all key on, and it is produced by the
  // proforma -> commercial conversion that triggers the documentation work.
  destinationCountryCode String? // ISO-3166 alpha-2
  destinationCountryName String?
  destinationMarket      String? // EU | US_JP_CA | AfCFTA | GSP | OTHER
  productForm            String   @default("Green") // Green | Roasted | Soluble | Liquid
  portLoading            String?
  portDischarge          String?
  paymentTerms           String?
  status        String   @default("Draft") // Draft | Issued | Sent | Paid | Cancelled
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  buyer    Buyer              @relation(fields: [buyerId], references: [id])
  proforma ProformaInvoice?   @relation(fields: [proformaId], references: [id])
  contract SalesContract?      @relation(fields: [contractId], references: [id])
  lines    CommercialInvoiceLine[]
  documents ExportDocument[]

  @@index([destinationCountryCode])
  @@map("commercial_invoices")
}

model CommercialInvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  lotId       String?
  description String
  quantityKg  Decimal @db.Decimal(14, 3)
  pricePerKg  Decimal @db.Decimal(14, 4)
  amount      Decimal @db.Decimal(18, 2)

  invoice CommercialInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("commercial_invoice_lines")
}

model Shipment {
  id          String   @id @default(cuid())
  code        String   @unique
  trackingNo  String?
  contractId  String?  @unique
  date        DateTime?
  mode        String   @default("Sea") // Sea | Air
  port        String?  @default("Djibouti")
  // Destination and the document pack live on the commercial invoice. The
  // shipment reaches them via contract.commercial so there is one source of
  // truth, not a copy that can drift.
  sealNo     String?
  billOfLading String?
  containerNo String?
  receiver    String?
  address     String?
  contact     String?
  itemDescription String?
  note        String?
  status      String   @default("Preparing") // Preparing | Docs Ready | Cleared | Shipped | Delivered
  trackingStatus String @default("Received") // Received | In Transit | Delivered
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contract SalesContract? @relation(fields: [contractId], references: [id])
  documents ExportDocument[]
  events    ShipmentEvent[]
  eudr      EudrStatement?

  @@map("shipments")
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  status     String // Received | In Transit | Delivered | Cleared | Docs Ready
  location   String?
  note       String?
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
  @@map("shipment_events")
}

// The export document pack. Anchored on the commercial invoice because that is
// the commercial transaction the documents describe; the invoice is created by
// the proforma conversion, which is what triggers documentation work.
//
// shipmentId is an optional logistics link. It is set when a shipment exists so
// carrier documents such as the bill of lading can be reached from tracking,
// but the invoice remains the owner of the pack.
model ExportDocument {
  id          String  @id @default(cuid())
  commercialInvoiceId String
  shipmentId  String?
  docType     String
  status      String  @default("Pending") // NotApplicable | Pending | InProgress | Ready | Submitted | Rejected
  reference   String?

  // ── Provenance of this row ─────────────────────────────────────────────
  // requirementId ties the row back to the rule that produced it. Lost when the
  // country changes; that is intentional, the snapshot fields below survive.
  requirementId String?
  countryCode   String? // "*" | ISO-3166 alpha-2 that produced the requirement
  mandatory     Boolean @default(true)
  conditional   Boolean @default(false)
  // Distinguishes what WE produce from what an AUTHORITY issues. An ERP-generated
  // application pack must never be presented as a government certificate.
  issuerType    String? // ERP_GENERATED | AUTHORITY_ISSUED | PRIVATE_PARTY
  artifactKind  String? // ERP_DOCUMENT | APPLICATION_DATA | AUTHORITY_RECEIPT | THIRD_PARTY_DOCUMENT
  authority     String?
  officialUrl   String?
  legalBasis    String?
  submissionMethod String? // PAPER | PDF | ONLINE | ELECTRONIC_DECLARATION | API | CERTIFICATE
  verificationStatus String? // VERIFIED | UNVERIFIED | NEEDS_LOCAL_CHECK
  verificationSource String?
  requiredData  Json?
  triggerConditions Json?
  leadTimeDays  Int?
  validUntil    DateTime?
  issuedAt      DateTime?
  issuedBy      String?
  notes         String?

  // Company-level documents are referenced, never copied. The snapshot keeps the
  // number/expiry as-at-use so a later licence lapse does not rewrite history.
  companyDocId  String?
  companyDocSnapshot Json? // { docType, number, expiresAt }

  attachmentId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  commercialInvoice CommercialInvoice @relation(fields: [commercialInvoiceId], references: [id], onDelete: Cascade)
  shipment   Shipment?      @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  requirement ComplianceRequirement? @relation(fields: [requirementId], references: [id])
  companyDoc CompanyDocument? @relation(fields: [companyDocId], references: [id])

  @@unique([commercialInvoiceId, docType])
  @@index([commercialInvoiceId, status])
  @@index([shipmentId])
  @@index([requirementId])
  @@map("export_documents")
}

// ───────────────────────────── Company-level documents ─────────────────────────────
// Held once and referenced by every shipment. Never duplicated per shipment.

model CompanyDocument {
  id           String   @id @default(cuid())
  docType      String // ECTA_CERTIFICATE_OF_COMPETENCY | BUSINESS_REGISTRATION | TRADE_LICENCE | TIN | VAT | BANK_REGISTRATION
  title        String
  issuer       String
  number       String
  issuedAt     DateTime
  expiresAt    DateTime?
  countryCode  String? // issuing jurisdiction
  requirementId String?
  attachmentId String?
  status       String   @default("Valid") // Valid | Expiring | Expired | Revoked
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requirement ComplianceRequirement? @relation(fields: [requirementId], references: [id])
  exportDocuments ExportDocument[]

  @@index([docType])
  @@index([expiresAt])
  @@map("company_documents")
}

// ───────────────────────────── Country compliance engine ─────────────────────────────
// Resolution: Shipment.destinationCountryCode -> Profile -> requirements whose
// countryCode is destination, marketBlock, or "*"; then product-form, effective
// date, and triggerConditions filters. Verified rows carry an official source.

model CountryComplianceProfile {
  id                 String   @id @default(cuid())
  countryCode        String   // ISO-3166 alpha-2
  countryName        String
  market             String   // EU | US_JP_CA | AfCFTA | GSP | OTHER
  marketBlock        String?  // e.g. "EU"; null when not block-scoped
  customsProcedureCpc String? // e.g. E100 direct public export
  active             Boolean  @default(true)
  effectiveFrom      DateTime @default(now())
  effectiveUntil     DateTime?
  lastVerifiedAt     DateTime?
  verificationSource String?
  notes              String?

  requirements ComplianceRequirement[]

  @@unique([countryCode, effectiveFrom])
  @@index([countryCode])
  @@map("country_compliance_profiles")
}

model ComplianceRequirement {
  id             String   @id @default(cuid())
  profileId      String?
  countryCode    String   @default("*") // ISO-3166 alpha-2, or "*" for all destinations
  marketBlock    String?
  name           String
  description    String
  authority      String
  requirementType String  // DOCUMENT | CERTIFICATE | DECLARATION | REGISTRATION | LICENSE | INSPECTION | TEST | TRACEABILITY | ELECTRONIC_SUBMISSION | API_SUBMISSION | CUSTOMS | FOOD_SAFETY | PLANT_HEALTH | ORIGIN
  scope          String   // COMPANY | SHARED | SHIPMENT | LOT | GOODS | DEST
  issuerType     String   // ERP_GENERATED | AUTHORITY_ISSUED | PRIVATE_PARTY
  documentType   String
  mandatory      Boolean  @default(true)
  conditional    Boolean  @default(false)
  triggerConditions Json?
  requiredData   Json?
  submissionMethod String @default("PAPER")
  officialUrl    String?
  legalBasis     String?
  leadTimeDays   Int?
  validityDays   Int?
  appliesToImporter Boolean @default(false)
  notes          String?
  effectiveFrom  DateTime @default(now())
  effectiveUntil DateTime?
  lastVerifiedAt DateTime?
  verificationStatus String @default("UNVERIFIED") // VERIFIED | UNVERIFIED | NEEDS_LOCAL_CHECK
  verificationSource String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile          CountryComplianceProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  exportDocuments ExportDocument[]
  companyDocuments  CompanyDocument[]
  templates        DocumentTemplate[]

  @@index([countryCode])
  @@index([marketBlock])
  @@index([scope])
  @@map("compliance_requirements")
}

// Three distinct things, deliberately kept apart:
//   A_OFFICIAL_TEMPLATE — the authority publishes a blank form
//   B_ERP_GENERATED    — we render this from shipment data
//   C_AUTHORITY_ISSUED — we supply application data; the authority issues it
model DocumentTemplate {
  id                String   @id @default(cuid())
  requirementId     String?
  documentType      String
  countryCode       String   @default("*")
  authority         String?
  templateKind      String   // A_OFFICIAL_TEMPLATE | B_ERP_GENERATED | C_AUTHORITY_ISSUED
  templateVersion   String?
  officialSourceUrl String?
  templateFile      String? // storage key
  format            String   @default("PDF") // PDF | HTML | DOCX | XLSX | JSON
  language          String   @default("en")
  versionDate       DateTime?
  effectiveFrom     DateTime @default(now())
  effectiveUntil    DateTime?
  lastVerifiedAt    DateTime?
  notes             String?

  requirement ComplianceRequirement? @relation(fields: [requirementId], references: [id])

  @@index([documentType])
  @@map("document_templates")
}

// ───────────────────────────── EUDR (Reg. 2023/1115) ─────────────────────────────
// The exporter has no filing obligation. The EU importer/operator submits the
// DDS to TRACES before the goods clear customs; our job is to supply plot
// geolocation and legality evidence, and to record the reference they send back.

model EudrStatement {
  id            String   @id @default(cuid())
  shipmentId    String   @unique
  ddsReference  String?  // reference issued by the EUDR Information System
  verificationNumber String?
  submitterParty String  @default("EU_IMPORTER") // we never file; recorded for the record
  submittedAt   DateTime?
  submittedByName String?
  status        String   @default("NotStarted") // NotStarted | GeodataPending | GeodataReady | Submitted | Accepted | Rejected
  commodity     String   @default("Coffee")
  hsCode        String?
  quantityKg    Decimal? @db.Decimal(14, 3)
  countryOfProduction String @default("Ethiopia")
  productionPeriodFrom DateTime?
  productionPeriodTo   DateTime?
  riskAssessment Json?
  riskMitigation Json?
  referenceYear String? // 31 December 2020 cut-off reference
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  plotLinks EudrPlotLink[]

  @@map("eudr_statements")
}

model EudrPlotLink {
  id           String @id @default(cuid())
  eudrStatementId String
  plotId       String
  geolocationSuppliedAt DateTime?

  eudr EudrStatement @relation(fields: [eudrStatementId], references: [id], onDelete: Cascade)
  plot Plot          @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@unique([eudrStatementId, plotId])
  @@index([plotId])
  @@map("eudr_plot_links")
}

// ───────────────────────────── Workflow support ─────────────────────────────

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String?
  entity    String?
  entityId  String?
  status    String   @default("Sent") // Sent | Failed | Queued
  provider  String?
  error     String?
  createdById String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("email_logs")
}

model Activity {
  id        String   @id @default(cuid())
  entity    String // ProformaInvoice | CommercialInvoice | Shipment | SalesContract | ...
  entityId  String
  type      String // status | email | note | created
  message   String
  actorId   String?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@map("activities")
}

model Approval {
  id            String   @id @default(cuid())
  entity        String // CherryPurchase | Expense | Payment
  entityId      String
  code          String?
  summary       String?
  amount        Decimal? @db.Decimal(18, 2)
  currency      String   @default("ETB")
  status        String   @default("Pending") // Pending | Approved | Rejected
  requestedById String?
  decidedById   String?
  note          String?
  createdAt     DateTime @default(now())
  decidedAt     DateTime?

  @@index([entity, entityId])
  @@index([status])
  @@map("approvals")
}

// ───────────────────────────── Market data ─────────────────────────────
// Cached benchmark quotes so the dashboard does not proxy an upstream API on
// every page view, and so a chart still renders when the upstream is down.

model CoffeeQuote {
  id         String   @id @default(cuid())
  symbol     String // upstream symbol, e.g. KC=F
  kind       String   @default("FUTURES") // FUTURES | INDICATOR
  source     String // yahoo | fred
  interval   String // 5m | 15m | 1d | 1mo
  priceDate  DateTime // the point's own timestamp
  open       Decimal? @db.Decimal(18, 6)
  high       Decimal? @db.Decimal(18, 6)
  low        Decimal? @db.Decimal(18, 6)
  close      Decimal  @db.Decimal(18, 6)
  volume     Decimal? @db.Decimal(20, 2)
  // Always normalised to USD per kilogram before storage. Upstream quotes
  // arabica in US cents per pound, and storing the raw unit would make the
  // benchmark and our own realised price incomparable.
  unit       String   @default("USD/kg")
  currency   String   @default("USD")
  fetchedAt  DateTime @default(now())

  @@unique([symbol, interval, priceDate])
  @@index([symbol, interval, priceDate])
  @@map("coffee_quotes")
}

// A record of what the market feed returned, so a failure is visible rather
// than presenting stale data as current.
model MarketFetchLog {
  id        String   @id @default(cuid())
  source    String
  symbol    String
  interval  String
  ok        Boolean
  points    Int      @default(0)
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("market_fetch_logs")
}

// ───────────────────────────── Payroll ─────────────────────────────
// Employees are deliberately separate from User: most staff on a payroll never
// log in to the ERP, and tying a payslip to an account would force one.

model Employee {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  employmentType String   @default("PERMANENT") // PERMANENT | CONTRACT
  position       String?
  department     String?
  stationId      String?
  hireDate       DateTime
  endDate        DateTime? // contract end, or termination date
  phone          String?
  email          String?
  tin            String?
  bankName       String?
  bankAccount    String?

  basicSalary          Decimal @db.Decimal(14, 2)
  transportAllowance   Decimal @default(0) @db.Decimal(14, 2)
  housingAllowance     Decimal @default(0) @db.Decimal(14, 2)
  otherAllowance       Decimal @default(0) @db.Decimal(14, 2)
  currency             String  @default("ETB")

  // Private-sector pension applies to permanent Ethiopian employees. Contract
  // staff are normally excluded, but this is overridable because the
  // engagement is what decides it, not the label.
  pensionEligible Boolean @default(true)

  status    String   @default("Active") // Active | OnLeave | Terminated
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  station Station?      @relation(fields: [stationId], references: [id])
  lines   PayrollLine[]

  @@index([status])
  @@index([employmentType])
  @@map("employees")
}

model PayrollRun {
  id           String   @id @default(cuid())
  code         String   @unique
  periodYear   Int
  periodMonth  Int // 1-12
  date         DateTime
  status       String   @default("Draft") // Draft | Approved | Paid
  notes        String?

  employeeCount      Int     @default(0)
  totalGross         Decimal @default(0) @db.Decimal(18, 2)
  totalIncomeTax     Decimal @default(0) @db.Decimal(18, 2)
  totalEmployeePension Decimal @default(0) @db.Decimal(18, 2)
  totalOtherDeductions Decimal @default(0) @db.Decimal(18, 2)
  totalNet           Decimal @default(0) @db.Decimal(18, 2)
  totalEmployerPension Decimal @default(0) @db.Decimal(18, 2)
  totalEmployerCost  Decimal @default(0) @db.Decimal(18, 2)

  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines PayrollLine[]

  @@unique([periodYear, periodMonth])
  @@index([status])
  @@map("payroll_runs")
}

// Employee details are snapshotted onto the line. A later salary change or a
// name correction must not silently rewrite a payroll that has already been
// approved and paid.
model PayrollLine {
  id         String @id @default(cuid())
  runId      String
  employeeId String

  employeeCode   String
  employeeName   String
  employmentType String
  position       String?
  pensionEligible Boolean @default(true)

  basicSalary  Decimal @db.Decimal(14, 2)
  allowances   Decimal @default(0) @db.Decimal(14, 2)
  overtime     Decimal @default(0) @db.Decimal(14, 2)
  grossPay     Decimal @db.Decimal(14, 2)

  taxableIncome    Decimal @db.Decimal(14, 2)
  incomeTax        Decimal @default(0) @db.Decimal(14, 2)
  employeePension  Decimal @default(0) @db.Decimal(14, 2)
  otherDeductions  Decimal @default(0) @db.Decimal(14, 2)
  netPay           Decimal @db.Decimal(14, 2)

  employerPension  Decimal @default(0) @db.Decimal(14, 2)
  employerCost     Decimal @db.Decimal(14, 2)

  notes String?

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])

  @@unique([runId, employeeId])
  @@index([runId])
  @@map("payroll_lines")
}
